# ─────────────────────────────────────────────
# UFGenius ALPACA SIGNAL BOT — API KEY TEMPLATE
# Copy this file to .env and fill in your keys
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Market Data
ALPHA_VANTAGE_KEY=
POLYGON_KEY=
FMP_KEY=
FINNHUB_KEY=

# Sentiment
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockBot/1.0 by u/yourusername

# Macro
FRED_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_google_app_password
EMAIL_TO=recipient@email.com

# Alpaca API (Official Stock Trading & Portfolio API)
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true

# AI explanations (optional, advisory-only; OFF unless explain.enabled=true).
# Default provider is Anthropic (Claude) via ANTHROPIC_API_KEY. To use an
# OpenAI-compatible provider instead (OpenAI, NVIDIA Nemotron, OpenRouter, …),
# set EXPLAIN_PROVIDER + EXPLAIN_BASE_URL + EXPLAIN_API_KEY + EXPLAIN_MODEL.
# ANTHROPIC_API_KEY=
# EXPLAIN_PROVIDER=openai
# EXPLAIN_BASE_URL=https://integrate.api.nvidia.com/v1
# EXPLAIN_API_KEY=
# EXPLAIN_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Network hardening
REQUEST_CONNECT_TIMEOUT_SEC=5
REQUEST_TIMEOUT_SEC=10
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_SEC=0.5
REQUEST_POOL_SIZE=20
YFINANCE_TIMEOUT_SEC=15
PROVIDER_CONCURRENCY_LIMIT=4

# Signal filtering
ALLOW_PENNY_STOCKS=false
SIGNAL_MIN_PRICE=1.0

# Phase 3 feature store
FEATURE_CACHE_TTL_SEC=300
FEATURE_CACHE_MAX_ENTRIES=2000
FEATURE_CACHE_VERSION=v1
FEATURE_ENABLE_REGIME_WEIGHTING=false

# Dashboard security
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
DASHBOARD_ALLOW_REMOTE=false
DASHBOARD_API_KEY=
DASHBOARD_API_KEYS=
DASHBOARD_RATE_LIMIT_PER_MIN=60
DASHBOARD_RATE_LIMIT_BACKEND=sqlite
DASHBOARD_RATE_LIMIT_DB_PATH=/tmp/ufgenius_rate_limit.sqlite3
DASHBOARD_TRUST_PROXY=false
DASHBOARD_MIN_ACCOUNT_SIZE=100
DASHBOARD_MAX_ACCOUNT_SIZE=10000000

# Paper-vs-validated-backtest tolerance gate (optional).
# Requires a baseline written by: python bot.py --mode validate --save-baseline
# When enabled, going live also requires the realized paper win rate / profit
# factor to sit within tolerance of the validated out-of-sample backtest —
# one-sided (outperformance never blocks) and fail-closed (no/stale/unvalidated
# baseline blocks). Defaults mirror config.yaml paper_scorecard.baseline_*.
PAPER_SCORECARD_BASELINE_GATE_ENABLED=false
PAPER_SCORECARD_BASELINE_TOLERANCE_PCT=30
PAPER_SCORECARD_BASELINE_MAX_AGE_DAYS=180
PAPER_SCORECARD_BASELINE_PATH=

# Finviz provider — fundamentals snapshot + screener (optional, default OFF).
# Finviz publishes no free API, so this reads public HTML; their terms restrict
# automated access and heavy use expects an Elite subscription, so enabling it is
# your call. Rate-limited and cached when on; fails soft if the layout changes.
FINVIZ_ENABLED=false
FINVIZ_MIN_REQUEST_INTERVAL_SEC=1.0
FINVIZ_CACHE_TTL_SEC=21600
FINVIZ_SCREENER_CACHE_TTL_SEC=900
FINVIZ_SCREENER_MAX_RESULTS=200
FINVIZ_USER_AGENT=

# Catalyst-triggered alerts (opt-in, default OFF) — fires on the NEWS WIRE
# rather than on price, so a catalyst is seen at publication time instead of
# after the move reaches a gainers list. Discovery/alerting only: nothing here
# sizes, gates, or places an order. Needs ALPACA_API_KEY/SECRET (the batch news
# wire is Alpaca-only) and TELEGRAM_* for delivery. Mirrors config.yaml
# movers.catalyst_alerts.*; env wins.
CATALYST_ALERTS_ENABLED=false
# watchlist (filters to CUSTOM_WATCHLIST — nothing fires if that is unset)
# | all (market-wide firehose: a name can surface before anyone lists it)
CATALYST_ALERTS_UNIVERSE=watchlist
# Comma-separated news_feed tiers: strong | moderate | weak | dilution.
# Unknown names are ignored with a warning; blank keeps the default.
CATALYST_ALERTS_TIERS=strong
CATALYST_ALERTS_LOOKBACK_SEC=300
CATALYST_ALERTS_DEDUP_TTL_SEC=3600
CATALYST_ALERTS_MAX_PER_RUN=5
CATALYST_ALERTS_SUPPRESS_HALTED=true

# Pre-market movers discovery (universe=PREMARKET for the pre-market screener).
# Separate from the regular-session movers chain, which reports the PREVIOUS
# session before 09:30. Coverage differs by provider and is disclosed in every
# result: polygon = market_wide (full snapshot), yahoo = bounded_pool (ranks the
# prior session's lists; keyless, but blind to a name that was quiet yesterday).
PREMARKET_MOVERS_PROVIDERS=polygon,yahoo
PREMARKET_MOVERS_LIMIT=50
PREMARKET_MOVERS_MIN_PRICE=1.0
PREMARKET_MOVERS_MIN_CHANGE_PCT=4.0
PREMARKET_MOVERS_YAHOO_SCREENERS=day_gainers,day_losers,most_actives,small_cap_gainers,aggressive_small_caps

# Backtest (optional)
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.001
# Which entry signal the backtest replays (audit B1).
#   composite = replay the LIVE generate_signal scorer point-in-time (only
#               technical+volume are reconstructible for a past bar, so those
#               weights are dropped and renormalised — a disclosed SUBSET)
#   proxy     = legacy hardcoded SMA/RSI rule; says nothing about the composite
BACKTEST_SIGNAL_SOURCE=proxy
BACKTEST_COMPOSITE_MIN_SCORE=65
# Score every Nth bar in composite mode (~28ms/bar; 5 = weekly, ~15x faster)
BACKTEST_COMPOSITE_STRIDE=1
# Candidate ordering when position slots are scarce (audit B2):
# rotate (name-neutral, default) | momentum | alphabetical (legacy, biased)
BACKTEST_CANDIDATE_RANKING=rotate
# Point-in-time universe membership JSON — reduces backtest survivorship bias (audit M11)
BACKTEST_UNIVERSE_HISTORY_PATH=
# Cache eviction trim target as a fraction of the size limit.
# Effective range [0.1, 1.0]; out-of-range values are clamped, non-finite fall back to 0.8.
CACHE_EVICTION_TARGET_RATIO=0.8
# User-Agent for constituent-list fetches (Wikipedia/iShares)
CONSTITUENT_FETCH_USER_AGENT=
